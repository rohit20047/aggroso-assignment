# Set these in your host's private environment; never commit real values.
PORT=3000
DATABASE_PATH=./migration-workbench.db
# Hosted storage: set Neon PostgreSQL connection string on Render.
# When set, DATABASE_URL takes precedence over local DATABASE_PATH.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
GEMINI_API_KEY=replace-with-your-gemini-key
# Gemini model; change without code edits if needed. Google lists a limited free tier.
GEMINI_MODEL=gemini-3.5-flash-lite
