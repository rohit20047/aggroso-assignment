{
  "name": "migration-workbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.json && vite build --config vite.config.ts",
    "start": "node dist/server.js",
    "test": "vitest run --root .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json"
  },
  "description": "Bounded data migration planning and reconciliation workbench",
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^6.4.4",
    "vitest": "2.1"
  }
}
